          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "final": {
          "description": "True when this report ends your work on the request",
          "type": "boolean"
        },
        "format": {
          "description": "markdown (default), or html for a self-contained page with its own charts or interactivity. It runs sandboxed: scripts may load libraries from cdn.jsdelivr.net, cdnjs.cloudflare.com or unpkg.com and images from https URLs, but can't fetch data, so embed the data in the page. Style it with the app's CSS variables so it matches light and dark mode: var(--ink) for text, var(--text-2) and var(--text-3) for secondary text, var(--surface) and var(--tile) for panels, var(--line) for borders, var(--ok), var(--warn) and var(--bad) only for status, var(--series-1) to var(--series-3) for chart series. Keep it flat and monochrome: no shadows, gradients or accent colours. Don't set fonts or a page background. Classes .card, .grid, .stat, .label, .muted and button.primary are ready to use. A script can read a colour with getComputedStyle(document.documentElement).getPropertyValue('--ink') and redraw on the window 'alexa:theme' event. A button may call alexa.send(text) to send the user's choice as their own visible message (only from a tap, at most 300 characters, one every 2 seconds). It never answers a confirm card: confirm with ask. Never name a top-level script variable status, name or top.",
          "enum": [
            "markdown",
            "html"
          ],
          "type": "string"
        },
        "id": {
          "description": "Id of an earlier report to replace with this version",
          "type": "string"
        },
        "items": {
          "description": "Optional key rows shown at the top, one per thing handled",
          "items": {
            "properties": {
              "detail": {
                "description": "Short detail like a date, price or status",
                "type": "string"
              },
              "label": {
                "description": "Item",
                "type": "string"
              }
            },
            "required": [
              "label"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "sources": {
          "description": "Sources and important links",
          "items": {
            "properties": {
              "title": {
                "description": "Title",
                "type": "string"
              },
              "url": {
                "description": "URL",
                "type": "string"
              }
            },
            "required": [
              "url"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "takeaway": {
          "description": "The one-line takeaway shown on the report's card, under 200 characters",
          "type": "string"
        },
