            "required": [
              "text",
              "status"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "title": {
          "description": "Short title for the job, e.g. \"Book a table for Friday\" (under 60 characters)",
          "type": "string"
        }
      },
      "required": [
        "steps"
      ],
      "type": "object"
    },
    "type": "function"
  },
