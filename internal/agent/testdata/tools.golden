[
  {
    "description": "Open a URL in the shared browser (the user sees it live). Returns the page state.",
    "name": "browser_open",
    "parameters": {
      "properties": {
        "done": {
          "description": "The same step in past tense, e.g. \"Opened the library website\".",
          "type": "string"
        },
        "status": {
          "description": "Short user-facing step label, present progressive, e.g. \"Opening the library website\".",
          "type": "string"
        },
        "url": {
          "description": "Absolute URL, or a domain like example.com",
          "type": "string"
        }
      },
      "required": [
        "url",
        "status"
      ],
      "type": "object"
    },
    "type": "function"
  },
  {
    "description": "Click the element with the given index from the latest browser state.",
    "name": "browser_click",
    "parameters": {
      "properties": {
        "done": {
          "description": "The same step in past tense, e.g. \"Opened the library website\".",
          "type": "string"
        },
        "index": {
          "description": "Element index",
          "type": "integer"
        },
        "status": {
          "description": "Short user-facing step label, present progressive, e.g. \"Opening the library website\".",
          "type": "string"
        }
      },
      "required": [
        "index",
        "status"
      ],
      "type": "object"
    },
    "type": "function"
  },
  {
    "description": "Click at viewport pixel coordinates of the latest screenshot (only when the target has no index).",
    "name": "browser_click_at",
    "parameters": {
      "properties": {
        "done": {
          "description": "The same step in past tense, e.g. \"Opened the library website\".",
          "type": "string"
        },
        "double": {
          "description": "Double-click",
          "type": "boolean"
        },
        "status": {
          "description": "Short user-facing step label, present progressive, e.g. \"Opening the library website\".",
          "type": "string"
        },
        "x": {
          "description": "X in pixels",
          "type": "number"
        },
        "y": {
          "description": "Y in pixels",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "status"
      ],
      "type": "object"
    },
    "type": "function"
  },
  {
    "description": "Type text into the element with the given index (focuses it first). Replaces existing text unless clear=false. Set submit=true to press Enter afterwards. Date, time and slider inputs get the value set directly: pass e.g. 2026-11-15, 19:30 or 4. The result says if the field ends up showing something else.",
    "name": "browser_type",
    "parameters": {
      "properties": {
        "clear": {
          "description": "Clear existing value first (default true)",
          "type": "boolean"
        },
        "done": {
          "description": "The same step in past tense, e.g. \"Opened the library website\".",
          "type": "string"
        },
        "index": {
          "description": "Element index (0 = currently focused element)",
          "type": "integer"
        },
        "status": {
          "description": "Short user-facing step label, present progressive, e.g. \"Opening the library website\".",
          "type": "string"
        },
        "submit": {
          "description": "Press Enter after typing",
          "type": "boolean"
        },
        "text": {
          "description": "Text to type",
          "type": "string"
        }
      },
      "required": [
        "index",
        "text",
        "status"
      ],
      "type": "object"
    },
    "type": "function"
  },
  {
    "description": "Move the mouse over an element (by index) or a point (x, y), for menus and tooltips that only appear on hover.",
    "name": "browser_hover",
    "parameters": {
      "properties": {
        "done": {
          "description": "The same step in past tense, e.g. \"Opened the library website\".",
          "type": "string"
        },
        "index": {
          "description": "Element index",
          "type": "integer"
        },
        "status": {
          "description": "Short user-facing step label, present progressive, e.g. \"Opening the library website\".",
          "type": "string"
        },
        "x": {
          "description": "X in pixels (when there's no index)",
          "type": "number"
        },
        "y": {
          "description": "Y in pixels",
          "type": "number"
        }
      },
      "required": [
        "status"
      ],
      "type": "object"
    },
    "type": "function"
  },
  {
    "description": "Drag from one element or point to another: drag and drop, reordering, sliders and handles. Give each end as an element index or as x/y coordinates; both ends must be in view.",
    "name": "browser_drag",
    "parameters": {
      "properties": {
        "done": {
          "description": "The same step in past tense, e.g. \"Opened the library website\".",
          "type": "string"
        },
        "from_index": {
          "description": "Element to drag",
          "type": "integer"
        },
        "from_x": {
          "description": "Start X (when there's no index)",
          "type": "number"
        },
        "from_y": {
          "description": "Start Y",
          "type": "number"
        },
        "status": {
          "description": "Short user-facing step label, present progressive, e.g. \"Opening the library website\".",
          "type": "string"
        },
        "to_index": {
          "description": "Element to drop on",
          "type": "integer"
        },
        "to_x": {
          "description": "End X (when there's no index)",
          "type": "number"
        },
        "to_y": {
          "description": "End Y",
          "type": "number"
        }
      },
      "required": [
        "status"
      ],
      "type": "object"
    },
    "type": "function"
  },
  {
    "description": "Answer the confirm or prompt dialog the page is showing (the browser state says when one is open; the page is frozen until it's answered). accept=true clicks OK, false clicks Cancel. For a prompt, text is what to type into it. A confirm can be consequential (\"Delete this?\"): check with the user first when it is.",
    "name": "browser_answer_dialog",
    "parameters": {
      "properties": {
        "accept": {
          "description": "true for OK, false for Cancel",
          "type": "boolean"
        },
        "done": {
          "description": "The same step in past tense, e.g. \"Opened the library website\".",
          "type": "string"
        },
        "status": {
          "description": "Short user-facing step label, present progressive, e.g. \"Opening the library website\".",
          "type": "string"
        },
        "text": {
          "description": "For a prompt: the text to enter",
          "type": "string"
        }
      },
      "required": [
        "accept",
        "status"
      ],
      "type": "object"
    },
    "type": "function"
  },
  {
    "description": "Press a key or key combination in the browser, e.g. Enter, Escape, Tab, ArrowDown, PageDown, Control+a.",
    "name": "browser_key",
    "parameters": {
      "properties": {
        "done": {
          "description": "The same step in past tense, e.g. \"Opened the library website\".",
          "type": "string"
        },
        "keys": {
          "description": "Key or combination",
          "type": "string"
        },
        "status": {
          "description": "Short user-facing step label, present progressive, e.g. \"Opening the library website\".",
          "type": "string"
        }
      },
      "required": [
        "keys",
        "status"
      ],
      "type": "object"
    },
    "type": "function"
  },
  {
    "description": "Scroll the page (or the scrollable area under an element).",
    "name": "browser_scroll",
    "parameters": {
      "properties": {
        "direction": {
          "enum": [
            "down",
            "up",
            "left",
            "right",
            "top",
            "bottom"
          ],
          "type": "string"
        },
        "done": {
          "description": "The same step in past tense, e.g. \"Opened the library website\".",
          "type": "string"
        },
        "index": {
          "description": "Optional element inside the area to scroll",
          "type": "integer"
        },
        "pages": {
          "description": "How far, in viewport heights (default 0.8)",
          "type": "number"
        },
        "status": {
          "description": "Short user-facing step label, present progressive, e.g. \"Opening the library website\".",
          "type": "string"
        }
      },
      "required": [
        "direction",
        "status"
      ],
      "type": "object"
    },
    "type": "function"
  },
  {
    "description": "Choose an option in a \u003cselect\u003e dropdown by its visible text or value.",
    "name": "browser_select",
    "parameters": {
      "properties": {
        "done": {
          "description": "The same step in past tense, e.g. \"Opened the library website\".",
          "type": "string"
        },
        "index": {
          "description": "Index of the \u003cselect\u003e",
          "type": "integer"
        },
        "option": {
          "description": "Option text or value",
          "type": "string"
        },
        "status": {
          "description": "Short user-facing step label, present progressive, e.g. \"Opening the library website\".",
          "type": "string"
        }
      },
      "required": [
        "index",
        "option",
        "status"
      ],
      "type": "object"
    },
    "type": "function"
  },
  {
    "description": "Go back or forward in the browser history, or reload.",
    "name": "browser_history",
    "parameters": {
      "properties": {
        "action": {
          "enum": [
            "back",
            "forward",
            "reload"
          ],
          "type": "string"
        },
        "done": {
          "description": "The same step in past tense, e.g. \"Opened the library website\".",
          "type": "string"
        },
        "status": {
          "description": "Short user-facing step label, present progressive, e.g. \"Opening the library website\".",
          "type": "string"
        }
      },
      "required": [
        "action",
        "status"
      ],
      "type": "object"
    },
    "type": "function"
  },
  {
    "description": "Get the current browser state (after waiting for something, or to re-check the page).",
    "name": "browser_state",
    "parameters": {
      "properties": {
        "done": {
          "description": "The same step in past tense, e.g. \"Opened the library website\".",
          "type": "string"
        },
        "status": {
          "description": "Short user-facing step label, present progressive, e.g. \"Opening the library website\".",
          "type": "string"
        },
        "wait_seconds": {
          "description": "Seconds to wait before reading (max 30)",
          "type": "number"
        }
      },
      "required": [
        "status"
      ],
      "type": "object"
    },
    "type": "function"
  },
  {
    "description": "Attach workspace files to a file input element.",
    "name": "browser_upload",
    "parameters": {
      "properties": {
        "done": {
          "description": "The same step in past tense, e.g. \"Opened the library website\".",
          "type": "string"
        },
        "index": {
          "description": "Index of the file input (or the element containing it)",
          "type": "integer"
        },
        "paths": {
          "description": "Workspace paths",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "status": {
          "description": "Short user-facing step label, present progressive, e.g. \"Opening the library website\".",
          "type": "string"
        }
      },
      "required": [
        "index",
        "paths",
        "status"
      ],
      "type": "object"
    },
    "type": "function"
  },
  {
    "description": "Read the full text of the current page as markdown (for extracting information without scrolling). Long pages are paged; pass offset to continue.",
    "name": "browser_read",
    "parameters": {
      "properties": {
        "done": {
          "description": "The same step in past tense, e.g. \"Opened the library website\".",
          "type": "string"
        },
        "offset": {
          "description": "Character offset to start from (default 0)",
          "type": "integer"
        },
        "status": {
          "description": "Short user-facing step label, present progressive, e.g. \"Opening the library website\".",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "type": "object"
    },
    "type": "function"
  },
  {
    "description": "Sign in with the user's saved login for the site open in the browser. The system types the username and password into the fields you give; you never see the password. Give the index of the username or email field, of the password field, or both (when a site asks for them on separate pages, call this on each page). If there's no saved login for the site, it says so: then call request_login.",
    "name": "browser_login",
    "parameters": {
      "properties": {
        "done": {
          "description": "The same step in past tense, e.g. \"Opened the library website\".",
          "type": "string"
        },
        "password_index": {
          "description": "Index of the password field",
          "type": "integer"
        },
        "status": {
          "description": "Short user-facing step label, present progressive, e.g. \"Opening the library website\".",
          "type": "string"
        },
        "submit": {
          "description": "Press Enter after filling in",
          "type": "boolean"
        },
        "username": {
          "description": "Which saved account to use, when there are several for the site",
          "type": "string"
        },
        "username_index": {
          "description": "Index of the username or email field",
          "type": "integer"
        }
      },
      "required": [
        "status"
      ],
      "type": "object"
    },
    "type": "function"
  },
  {
    "description": "Ask the user to sign in to a site through a secure form on their screen: they type their username and password there, and can save them so you can sign in by yourself next time (for example when the session expires). You never see the password. When they've entered it, call browser_login to fill in the sign-in form. Use this when browser_login says there's no saved login for the site, or the saved one was rejected. Calls after this one in the same turn don't run; call them again after the user answers.",
    "name": "request_login",
    "parameters": {
      "properties": {
        "done": {
          "description": "The same step in past tense, e.g. \"Opened the library website\".",
          "type": "string"
        },
        "reason": {
          "description": "Short note shown above the form, e.g. \"Your Amazon session expired\"",
          "type": "string"
        },
        "site": {
          "description": "The site to sign in to, when it isn't the one open in the browser (e.g. the sign-in form is in a frame from another site)",
          "type": "string"
        },
        "status": {
          "description": "Short user-facing step label, present progressive, e.g. \"Opening the library website\".",
          "type": "string"
        }
      },
      "required": [
        "reason",
        "status"
      ],
      "type": "object"
    },
    "type": "function"
  },
  {
    "description": "Pause and ask the user to take over the shared browser — for 2FA codes, CAPTCHAs, payment details, or anything else only they can do on the page (for signing in, use browser_login and request_login). Their screen switches to the browser. You resume when they hand back control. Calls after this one in the same turn don't run; call them again after the user answers.",
    "name": "request_takeover",
    "parameters": {
      "properties": {
        "done": {
          "description": "The same step in past tense, e.g. \"Opened the library website\".",
          "type": "string"
        },
        "reason": {
          "description": "Short instruction shown to the user, e.g. \"Sign in to continue\"",
          "type": "string"
        },
        "status": {
          "description": "Short user-facing step label, present progressive, e.g. \"Opening the library website\".",
          "type": "string"
        }
      },
      "required": [
        "reason",
        "status"
      ],
      "type": "object"
    },
    "type": "function"
  },
  {
    "description": "Send the user a short message. This is the only way the user sees anything you write: your plain text output is hidden. For a task you've done, a few words: \"Done.\" or \"Done. \u003cthe state they need\u003e\". Otherwise one or two plain sentences, under 300 characters, no headings, lists or tables. Attach blocks only for things to choose between, compare or check (see Showing results). Messages are pushed to the user's phone automatically when they're away.",
    "name": "say",
    "parameters": {
      "properties": {
        "blocks": {
          "description": "Up to 3 blocks shown under the message (see Showing results)",
          "items": {
            "properties": {
              "align": {
                "description": "table: how each column is aligned",
                "items": {
                  "enum": [
                    "left",
                    "right",
                    "center"
                  ],
                  "type": "string"
                },
                "type": "array"
              },
              "columns": {
                "description": "table: the column headings (up to 6)",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "currency": {
                "description": "chart: the ISO currency of the values",
                "type": "string"
              },
              "days": {
                "description": "timeline: [{date, items: [{time, end, title, kind, place, note}]}]",
                "items": {
                  "type": "object"
                },
                "type": "array"
              },
              "items": {
                "description": "cards: the cards; compare: [{name, price, pick}]; stats, checklist, links and images: their entries; files: [{path}]",
                "items": {},
                "type": "array"
              },
              "kind": {
                "description": "cards: what the cards are",
                "enum": [
                  "product",
                  "place",
                  "stay",
                  "flight",
                  "event",
                  "item"
                ],
                "type": "string"
              },
              "lines": {
                "description": "receipt: [{label, value}]",
                "items": {
                  "type": "object"
                },
                "type": "array"
              },
              "marks": {
                "description": "chart: up to 5 of {x, label}",
                "items": {
                  "type": "object"
                },
                "type": "array"
              },
              "merchant": {
                "description": "receipt: who it's from",
                "type": "string"
              },
              "ref": {
                "description": "receipt: the order or booking reference",
                "type": "string"
              },
              "rows": {
                "description": "table: one list of cells per row; compare: [{label, values, best}]",
                "items": {},
                "type": "array"
              },
              "series": {
                "description": "chart: up to 3 of {name, points: [{x, y}]}",
                "items": {
                  "type": "object"
                },
                "type": "array"
              },
              "status": {
                "description": "receipt",
                "enum": [
                  "draft",
                  "pending",
                  "confirmed",
                  "cancelled",
                  "failed"
                ],
                "type": "string"
              },
              "style": {
                "description": "chart",
                "enum": [
                  "line",
                  "bar"
                ],
                "type": "string"
              },
              "text": {
                "description": "callout: under 280 characters; markdown (reports only): the prose",
                "type": "string"
              },
              "title": {
                "description": "Optional heading, under 60 characters",
                "type": "string"
              },
              "tone": {
                "description": "callout",
                "enum": [
                  "info",
                  "tip",
                  "warning",
                  "success"
                ],
                "type": "string"
              },
              "total": {
                "description": "receipt: the total",
                "properties": {
                  "amount": {
                    "description": "Amount",
                    "type": "number"
                  },
                  "currency": {
                    "description": "ISO currency code, e.g. USD",
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "type": {
                "description": "The block type",
                "enum": [
                  "cards",
                  "compare",
                  "table",
                  "stats",
                  "chart",
                  "timeline",
                  "checklist",
                  "receipt",
                  "links",
                  "images",
                  "files",
                  "callout",
                  "markdown"
                ],
                "type": "string"
              },
              "unit": {
                "description": "chart: the unit of the values",
                "type": "string"
              },
              "verdict": {
                "description": "compare: the conclusion in one line",
                "type": "string"
              },
              "x": {
                "description": "chart: what the x axis shows",
                "enum": [
                  "time",
                  "category"
                ],
                "type": "string"
              }
            },
            "required": [
              "type"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "email": {
          "description": "Also email it (only when they asked for email)",
          "type": "boolean"
        },
        "final": {
          "description": "True when this message ends your work on the request",
          "type": "boolean"
        },
        "push": {
          "description": "Also push it to their phone even if they have Alexa open (alerts, reminders)",
          "type": "boolean"
        },
        "sources": {
          "description": "Web pages you relied on for this message, up to 6",
          "items": {
            "properties": {
              "title": {
                "description": "Title",
                "type": "string"
              },
              "url": {
                "description": "URL",
                "type": "string"
              }
            },
            "required": [
              "url"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "suggestions": {
          "description": "Up to 3 short follow-ups the user might tap, in their words, under 40 characters each (e.g. \"Track the price\")",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "text": {
          "description": "The message, as you'd say it aloud",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "type": "object"
    },
    "type": "function"
  },
  {
    "description": "Ask the user a question and wait for the answer — to confirm consequential actions (purchases, sending, booking, deleting) or to resolve real ambiguity. Short and self-contained, under 300 characters. Offer options when there are clear choices, and mark the one you'd pick with recommended. Before buying, booking or sending, set confirm and put a draft receipt in blocks. Calls after this one in the same turn don't run; call them again after the user answers.",
    "name": "ask",
    "parameters": {
      "properties": {
        "blocks": {
          "description": "Up to 2 blocks of context shown with the question: a draft receipt, or the cards being chosen between (see Showing results)",
          "items": {
            "properties": {
              "align": {
                "description": "table: how each column is aligned",
                "items": {
                  "enum": [
                    "left",
                    "right",
                    "center"
                  ],
                  "type": "string"
                },
