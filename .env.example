# Copy to .env and fill in. Only META_MODEL_API_KEY is required.

# Meta Model API key (https://api.meta.ai). Used for the agent model,
# live voice transcription and image generation.
META_MODEL_API_KEY=

# Public URL people use to reach Alexa (used in notification/email links).
PUBLIC_URL=http://raspberrypi.local:8080

# Model settings.
# MODEL=muse-spark-1.3-contributor
# REASONING_EFFORT=medium        # minimal | low | medium | high

# Each user has one never-ending conversation. When a prompt grows past
# this many tokens, the older part is folded into a running summary.
# COMPACT_TOKENS=120000

# Let anyone with the URL create an account (the first account is always
# allowed and becomes admin). Otherwise the admin adds users in the app.
ALLOW_SIGNUP=false

# Set to true when serving over HTTPS (e.g. behind Caddy or a tunnel).
SECURE_COOKIES=false

# Optional: email notifications via Resend.
# RESEND_API_KEY=
# MAIL_FROM=Alexa <alexa@yourdomain.com>

# Optional tuning.
# BROWSER_IDLE_MINUTES=15        # close a user's browser after this long idle
# MAX_TURNS=200                  # max model turns per stretch of work
# SHELL_ENABLED=true             # let the agent run shell commands in the user's workspace
