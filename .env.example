# Copy to .env and fill in. Only META_MODEL_API_KEY is required.

# Meta Model API key (https://api.meta.ai). Used for the agent model,
# live voice transcription and image generation.
META_MODEL_API_KEY=

# Public URL people use to reach Alexa (used in notification/email links).
PUBLIC_URL=http://raspberrypi.local:8080

# Model settings.
# MODEL=muse-spark-1.3-contributor
# REASONING_EFFORT=medium        # minimal | low | medium | high

# Each user has one never-ending conversation. When a prompt grows past
# this many tokens, the older part is folded into a running summary.
# COMPACT_TOKENS=120000

# A message sent while Alexa is idle either carries on the topic on screen
# (the screen keeps it) or starts a new one (the screen starts clean). A
# quick model call decides; false skips it and starts every request clean.
# TOPIC_JUDGE=true

# Every this many of a user's messages, while Alexa is idle, one model call
# reads what they and Alexa said and may save up to three lasting facts to
# memory (shown as learned). It never reads page or file text. 0 turns it off.
# MEMORY_REVIEW_EVERY=8

# Let anyone with the URL create an account (the first account is always
# allowed and becomes admin). Otherwise the admin adds users in the app.
ALLOW_SIGNUP=false

# Set to true when serving over HTTPS (e.g. behind Caddy or a tunnel).
SECURE_COOKIES=false

# Behind a reverse proxy: publish the port on localhost only, and take each
# visitor's address from X-Real-IP, which the proxy must overwrite (sign-in
# limits go by it). Leave both unset when browsers reach Alexa directly.
# ALEXA_BIND=127.0.0.1:6035
# TRUST_PROXY=true

# Saved logins are encrypted with a key kept in DATA_DIR/vault.key (made on
# first start). To keep the key apart from the database and its backups,
# point this at a file elsewhere, e.g. a Docker secret.
# VAULT_KEY_FILE=/run/secrets/alexa_vault_key

# Optional: email notifications via Resend.
# RESEND_API_KEY=
# MAIL_FROM=Alexa <alexa@yourdomain.com>

# Optional tuning.
# BROWSER_IDLE_MINUTES=15        # close a user's browser after this long idle
# MAX_TURNS=200                  # max model turns per stretch of work
# SHELL_ENABLED=true             # let the agent run shell commands in the user's workspace
